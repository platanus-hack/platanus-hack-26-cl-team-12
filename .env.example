# ════════════════════════════════════════════════════════════════════════════
#  Puente: variables de entorno
# ════════════════════════════════════════════════════════════════════════════
#  Uso:   make env   (o:  cp .env.example .env)   y rellena los valores.
#  NUNCA commitees el .env: tiene claves. Este archivo (.env.example) sí se versiona y NO debe tener claves reales.
#
#  Etiquetas:
#    [obligatoria]  sin ella la pieza no funciona.
#    [opcional]     tiene un valor por defecto en el código (se muestra).
#    [reservada]    la reserva el diseño, pero ningún código la lee todavía.
#
#  Dónde se carga:
#    - services/api y services/agent leen el .env de la RAÍZ del repo (python-dotenv; verificado).
#    - apps/web (Next.js) NO lee el .env de la raíz (verificado). Sus variables NEXT_PUBLIC_* van en
#      apps/web/.env.local (ya ignorado por git) o, en producción, en el panel de Vercel.
#    - En producción no se usa archivo: se cargan como secretos del proveedor (`fly secrets set`, Vercel).
#      Ver docs/DESPLIEGUE.md.
#
#  Formato: los comentarios van en líneas propias (docker --env-file no admite comentarios al final de línea).
#  Detalle y decisiones: docs/ARQUITECTURA.md §3.7.
# ════════════════════════════════════════════════════════════════════════════


# ───── Anthropic: traductor de glosas ↔ español (services/agent) ─────────────
# [obligatoria] Clave de la API. Se obtiene en https://console.anthropic.com
ANTHROPIC_API_KEY=

# [opcional] Modelo del traductor. Defecto: claude-haiku-5-5 (rápido; sube a un modelo mayor solo si la calidad lo exige).
TRANSLATOR_MODEL=claude-haiku-5-5

# [opcional] Escenario de la demo: id de packages/glosses/data/escenarios/<id>.json (descripción, ejemplos de los
# prompts, keyterms del STT y pronunciaciones). Defecto: hora_medica. ESCENARIO_PATH acepta una ruta a otro JSON.
ESCENARIO=hora_medica

# [opcional] Base de datos local del agente (SQLite): caché de frases sin datos personales, latencia por turno y glosas
# faltantes. Defecto: services/agent/.data/puente.db. En contenedor usa /tmp/puente.db; "off" la desactiva.
AGENT_DB_PATH=
# [opcional] Vigencia de la caché de traducciones, en segundos. Defecto: 86400 (24 h). Solo se cachean las frases de la
# lista blanca del escenario (`frases_frecuentes`); ningún texto libre de la llamada.
AGENT_CACHE_TTL_S=86400
# [opcional] Retención de la tabla de glosas faltantes, en segundos. Defecto: 604800 (7 días).
AGENT_FALTANTES_TTL_S=604800


# ───── LiveKit: salas WebRTC y SIP (services/api y services/agent) ───────────
# [obligatoria] URL del proyecto de LiveKit Cloud, con wss://. Ej.: wss://mi-proyecto.livekit.cloud
LIVEKIT_URL=

# [obligatoria] Clave y secreto del proyecto (LiveKit Cloud → Settings → Keys). Secretos.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# [reservada] Id del trunk SIP saliente hacia Twilio. Lo usará POST /llamadas cuando se implemente (TODO(v1)).
LIVEKIT_SIP_TRUNK_ID=


# ───── Voz a texto: Deepgram (services/agent) ────────────────────────────────
# [obligatoria] Clave de Deepgram. https://console.deepgram.com
DEEPGRAM_API_KEY=

# [opcional] Idioma del STT. Defecto: es. (Falta medir el acento chileno por teléfono a 8 kHz.)
STT_LANGUAGE=es
# [opcional] Modelo y formato del STT. smart_format convierte "diez y media" en "10:30". Defectos: nova-3 y 1.
STT_MODEL=nova-3
STT_SMART_FORMAT=1


# ───── Texto a voz: ElevenLabs (services/agent) ──────────────────────────────
# [obligatoria] Clave de ElevenLabs. El plugin de LiveKit espera ELEVEN_API_KEY, pero el agente ya la toma de
# esta variable (ELEVENLABS_API_KEY) y se la pasa al plugin.
ELEVENLABS_API_KEY=

# [obligatoria] Voz chilena de MUJER (Voice Library). Es la voz por defecto. Sin ella el agente no arranca.
ELEVENLABS_VOICE_ID=Fd38GRHtJllY0CuguAy9
# [opcional] Voz chilena de HOMBRE. Si falta, se usa la de mujer.
ELEVENLABS_VOICE_ID_HOMBRE=6WgXEzo1HGn3i7ilT4Fh
# [opcional] Voz por defecto del cliente: mujer | hombre. El atributo `voz` del participante cliente la cambia.
VOZ_CLIENTE=mujer

# [opcional] Modelo TTS. Defecto: eleven_flash_v2_5 (baja latencia, para llamadas en vivo).
ELEVENLABS_MODEL=eleven_flash_v2_5


# ───── API (services/api) ────────────────────────────────────────────────────
# [opcional] Ambiente: development | production. En development hay Swagger en http://localhost:8000/docs
# (y ReDoc en /redoc). En production se apaga. El Dockerfile de la API ya fija production. Defecto: development.
API_ENV=development
# [opcional] Fuerza Swagger encendido (1) o apagado (0), sin importar API_ENV.
API_DOCS=
# [opcional] Orígenes permitidos por CORS, separados por coma. Defecto: http://localhost:3000.
# En producción: la URL exacta de la PWA (con https://, sin / final). NUNCA uses *.
CORS_ORIGINS=http://localhost:3000

# [opcional] Números a los que se puede llamar (E.164, separados por coma). Ej.: +56912345678,+56987654321
# Vacío = se bloquean TODAS las llamadas salientes (anti fraude telefónico).
ALLOWED_DESTINATIONS=

# [opcional] Otra ruta al diccionario de glosas. Defecto: packages/glosses/data/glosses.json
# GLOSSES_PATH=


# ───── Web (apps/web) ────────────────────────────────────────────────────────
# OJO: Next.js no lee este .env. Para cambiarla en local, ponla en apps/web/.env.local; en producción, en Vercel.
# Se "hornea" en el build estático: si la cambias, hay que volver a compilar y desplegar.
# Todo lo que empieza con NEXT_PUBLIC_ queda visible en el navegador: nunca pongas secretos aquí.
# URL pública de la API. En desarrollo, si falta, usa http://localhost:8000; en la app publicada es obligatoria.
NEXT_PUBLIC_API_URL=http://localhost:8000
# La app se conecta a la llamada por el WebSocket /twilio/cliente de services/api (plan C). En la app publicada
# NEXT_PUBLIC_API_URL es obligatoria.
# El mismo valor que CLIENTE_WS_TOKEN de la API (clave de demo compartida; queda visible en el navegador).
NEXT_PUBLIC_CLIENTE_WS_TOKEN=
# Fotos de las señas (Diccionario LSCh) en un bucket S3, p. ej. https://<bucket>.s3.<región>.amazonaws.com/senas.
# Vacía = las fotos locales de apps/web/public/senas. Se suben con `make senas-push` (bucket de SENAS_S3_BUCKET, más abajo).
NEXT_PUBLIC_SENAS_URL=


# ───── Twilio: telefonía real, v1 (services/api) ─────────────────────────────
# Plan C (app/twilio_media.py). La cuenta trial solo llama a números verificados; habilita Chile en
# "Voice Geographic Permissions". Ver docs/DESPLIEGUE.md §8.
TWILIO_ACCOUNT_SID=
# Con valor, la API rechaza (403) los POST a /twilio/* sin `X-Twilio-Signature` válida. Vacío = sin validar en dev; con API_ENV=production responde 503.
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Secreto compartido con la app del cliente: el WebSocket /twilio/cliente exige `?token=<esto>`. Vacío = abierto en dev; cerrado con API_ENV=production.
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(24))"
CLIENTE_WS_TOKEN=
# Opcionales (lab/): MODELO_LLM=claude-haiku-5-5  ELEVENLABS_STT_MODEL=scribe_v1  ELEVENLABS_TTS_MODEL=eleven_flash_v2_5


# ───── AWS S3: fotos de señas LSCh (make senas-pull / make senas-push) ───────
# [opcional] Bucket con las fotos del Diccionario LSCh (derechos UMCE: no van al repo). Solo senas/* es de lectura
# pública, para que la web desplegada las muestre; subir pide credenciales. Sin fotos la app usa el
# avatar de palitos. Credenciales: `aws login` / `aws configure` (no van aquí). Ver docs/ONBOARDING.md.
SENAS_S3_BUCKET=puente-senas-lsch
AWS_REGION=us-east-1
# [opcional] Perfil de ~/.aws/config. Vacío = el perfil por defecto.
AWS_PROFILE=


# ───── Supabase: base de datos, archivos y auth (plan, ADR-0009) ─────────────
# [reservada] Todavía no hay proyecto ni código que las use. Ver docs/ARQUITECTURA.md §2.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SOLO backend. Salta las políticas de seguridad por fila: nunca en el cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ───── Heredada del scaffold original ────────────────────────────────────────
# [reservada] URL pública del backend para webhooks de Twilio (en desarrollo, la de ngrok). Hoy ningún código la lee.
PUBLIC_BASE_URL=

# Demo: teléfono al que llaman los contactos de la app (debe estar en ALLOWED_DESTINATIONS)
NUMERO_DEMO=
