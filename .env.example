# Copia a .env y rellena (nunca commitear .env)
ANTHROPIC_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
PUBLIC_BASE_URL=   # URL pública del backend (ngrok en dev)

# --- LiveKit (ADR-0005) ---
LIVEKIT_URL=            # wss://<proyecto>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=   # trunk SIP saliente hacia Twilio (v1)

# --- Voz (ADR-0006) ---
ELEVENLABS_VOICE_ID=    # voz con acento chileno (Voice Library o clonada con consentimiento)
ELEVENLABS_MODEL=eleven_flash_v2_5
STT_LANGUAGE=es

# --- Agente / API ---
TRANSLATOR_MODEL=claude-haiku-5-5
ESCENARIO_DEMO=reserva de hora médica
CORS_ORIGINS=*

# --- Supabase (ADR-0009) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # solo backend, nunca en el cliente

# --- Web (apps/web, se expone al navegador) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
