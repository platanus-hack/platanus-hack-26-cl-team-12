 {
  "id": "frase-p1",
  "glosa": "FRASE-P1",
  "significa": "Hola, necesito una ambulancia. Mi hijo se cayó y se quebró el codo.  →  HOLA AMBULANCIA NECESITAR / HIJO-A CAER-PERSONA / CODO HUESO ROMPER",
  "tipo": "frase"
 },
 {
  "id": "frase-c1",
  "glosa": "FRASE-C1",
  "significa": "Hola, ¿su hijo está consciente y respira bien?  →  HOLA / HIJO-A DESPERTAR-SE / RESPIRAR BIEN",
  "tipo": "frase"
 },
 {
  "id": "frase-p2",
  "glosa": "FRASE-P2",
  "significa": "Sí, está consciente, pero no puede apoyar el brazo y el codo está muy hinchado.  →  SI HIJO-A DESPERTAR-SE PERO / BRAZO APOYAR NO-PODER / CODO HINCHADO-A",
  "tipo": "frase"
 },
 {
  "id": "frase-c2",
  "glosa": "FRASE-C2",
  "significa": "Entendido. ¿Hay sangrado o la mano se ve pálida o fría?  →  ENTENDER / SANGRE / MANO PALIDO-A FRIO",
  "tipo": "frase"
 },
 {
  "id": "frase-p3",
  "glosa": "FRASE-P3",
  "significa": "Hay un poco de sangre, pero la mano está normal. Necesito un traslado urgente.  →  SANGRE POCO-A PERO / MANO BIEN / URGENTE NECESITAR HOSPITAL IR",
  "tipo": "frase"
 },
 {
  "id": "frase-c3",
  "glosa": "FRASE-C3",
  "significa": "Registramos la solicitud de ambulancia. Tenemos su dirección señora, vamos en camino. Mientras llega, no mueva el brazo de su hijo.  →  SOLICITUD AMBULANCIA ANOTAR / DOMICILIO TENER SENORA / AMBULANCIA VENIR CAMINO / ESPERAR / BRAZO HIJO-A QUIETO-A",
  "tipo": "frase"
 }
]